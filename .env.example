# MailGuard AI Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Flask App Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=mailguard-ai-secure-secret-key-change-in-production

# Server Configuration
PORT=5000
HOST=127.0.0.1

# Google OAuth Paths (relative or absolute)
CREDENTIALS_FILE=credentials/credentials.json
TOKEN_FILE=token.json

# OAuth Scopes (Gmail Readonly)
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
